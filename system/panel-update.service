[Unit]
Description=HA Panel Nightly Update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Invoke via bash: commits made through the GitHub API are mode 100644 and
# git reset strips any manually-set exec bit, so a direct ExecStart on the
# script fails with status 203/EXEC. Same rule as the .bash_profile hook.
ExecStart=/usr/bin/bash /opt/ha-panel/repo/system/update.sh
StandardOutput=journal
StandardError=journal
